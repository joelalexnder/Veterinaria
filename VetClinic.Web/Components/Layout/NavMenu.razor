@implements IDisposable
@inject VetClinic.Web.Services.AuthStateService AuthState

<div class="nav-scrollable">
    <nav class="flex-column">
        @if (AuthState.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">🏠 Inicio</NavLink>
            </div>

            @if (AuthState.Role is "Administrador")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">👥 Usuarios</NavLink>
                </div>
            }

            @if (AuthState.Role is "Administrador" or "Veterinario" or "Recepcionista")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="owners">🧑 Propietarios</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="appointments">📅 Citas</NavLink>
                </div>
            }

            @if (AuthState.Role is "Administrador" or "Veterinario")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="vaccination">💉 Vacunación</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="ai-summary">🤖 Resumen IA</NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChanged;
    }

    private void HandleAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChanged;
    }
}