@page "/ai-summary"
@using System.Text.RegularExpressions
@inject VetClinic.Web.Services.AuthStateService AuthState
@inject NavigationManager Nav
@inject VetClinic.Web.Services.ApiClient Api
@rendermode InteractiveServer

<h3>🤖 Resumen de Salud con IA</h3>

<div class="row">
    <div class="col-md-4">
        <label>1. Seleccionar Propietario</label>
        <select class="form-select mb-3" @bind="selectedOwnerId" @bind:after="LoadPets">
            <option value="0">-- Elige un propietario --</option>
            @foreach (var owner in owners)
            {
                <option value="@owner.Id">@owner.FullName</option>
            }
        </select>

        <label>2. Seleccionar Mascota</label>
        <select class="form-select mb-3" @bind="petId" disabled="@(pets.Count == 0)">
            <option value="0">-- Elige una mascota --</option>
            @foreach (var pet in pets)
            {
                <option value="@pet.Id">@pet.Name</option>
            }
        </select>
        
        <button class="btn btn-primary" @onclick="GetSummary" disabled="@(loading || petId == 0)">
            @(loading ? "Generando..." : "Generar resumen")
        </button>
    </div>

    <div class="col-md-8">
        @if (summary != null)
        {
            <div class="card p-3 shadow-sm">
                <h6 class="text-primary">Resumen generado:</h6>
                <p style="white-space: pre-line">@((MarkupString)FormatMarkdownToHtml(summary))</p>
            </div>
        }
        @if (error != null)
        {
            <div class="alert alert-danger">@error</div>
        }
    </div>
</div>

@code {
    private int selectedOwnerId;
    private int petId;
    private string? summary;
    private string? error;
    private bool loading;
    
    private List<OwnerDto> owners = new(); 
    private List<PetDto> pets = new(); 

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (AuthState.Role is not ("Administrador" or "Veterinario"))
        {
            Nav.NavigateTo("/owners");
            return;
        }

        var fetchedOwners = await Api.GetOwnersAsync();
        if (fetchedOwners != null)
        {
            owners = fetchedOwners;
        }
    }

    private async Task LoadPets()
    {
        petId = 0; 
        pets.Clear(); 
        summary = null; 

        if (selectedOwnerId > 0)
        {
            var fetchedPets = await Api.GetPetsByOwnerAsync(selectedOwnerId);
            if (fetchedPets != null)
            {
                pets = fetchedPets;
            }
        }
    }

    private async Task GetSummary()
    {
        if (petId == 0) return; 

        loading = true;
        error = null;
        summary = null;

        var result = await Api.GetPetHealthSummaryAsync(petId);

        if (result is null)
            error = "No se pudo generar el resumen. Verifica la conexión.";
        else
            summary = result;

        loading = false;
    }

    private string FormatMarkdownToHtml(string text)
    {
        if (string.IsNullOrEmpty(text)) return text;
        return Regex.Replace(text, @"\*\*(.*?)\*\*", "<strong>$1</strong>");
    }
}