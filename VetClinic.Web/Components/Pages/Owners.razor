@page "/owners"
@inject VetClinic.Web.Services.ApiClient Api
@rendermode InteractiveServer
@using VetClinic.Web.Models
@using System.Text.RegularExpressions

<h3>🧑 Propietarios y Mascotas</h3>

<div class="row">
    <div class="col-md-5">
        <h5>Registrar Propietario</h5>
        <EditForm Model="ownerModel" OnValidSubmit="RegisterOwner">
            <InputText class="form-control mb-2" placeholder="Nombre completo" @bind-Value="ownerModel.FullName" />
            <InputText class="form-control mb-2" placeholder="DNI (8 dígitos)" @bind-Value="ownerModel.Dni" maxlength="8" />
            <InputText class="form-control mb-2" placeholder="Teléfono (9 dígitos)" @bind-Value="ownerModel.Phone" maxlength="9" />
            <InputText class="form-control mb-2" placeholder="Email" @bind-Value="ownerModel.Email" />
            <InputText class="form-control mb-2" placeholder="Dirección" @bind-Value="ownerModel.Address" />
            <button class="btn btn-primary w-100">Registrar</button>
        </EditForm>

        @if (ownerMsg != null) { <div class="alert @(ownerOk ? "alert-success" : "alert-danger") mt-2">@ownerMsg</div> }

        <hr />

        <h5>Registrar Mascota</h5>
        <EditForm Model="petModel" OnValidSubmit="RegisterPet">
            <select class="form-select mb-2" @bind="petModel.OwnerId">
                <option value="0">-- Selecciona propietario --</option>
                @foreach (var o in owners)
                {
                    <option value="@o.Id">@o.FullName (@o.Dni)</option>
                }
            </select>
            <InputText class="form-control mb-2" placeholder="Nombre mascota" @bind-Value="petModel.Name" />
            <InputText class="form-control mb-2" placeholder="Especie (Canino/Felino)" @bind-Value="petModel.Species" />
            <InputText class="form-control mb-2" placeholder="Raza" @bind-Value="petModel.Breed" />
            <button class="btn btn-success w-100">Registrar Mascota</button>
        </EditForm>

        @if (petMsg != null) { <div class="alert @(petOk ? "alert-success" : "alert-danger") mt-2">@petMsg</div> }
    </div>

    <div class="col-md-7">
        <h5>Propietarios registrados</h5>
        <table class="table table-sm table-striped">
            <thead><tr><th>Nombre</th><th>DNI</th><th>Mascotas</th></tr></thead>
            <tbody>
                @foreach (var o in owners)
                {
                    <tr>
                        <td>@o.FullName</td>
                        <td>@o.Dni</td>
                        <td>@string.Join(", ", o.PetNames)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<OwnerDto> owners = new();
    private RegisterOwnerRequest ownerModel = new();
    private RegisterPetRequest petModel = new();
    private string? ownerMsg;
    private string? petMsg;
    private bool ownerOk;
    private bool petOk;

    protected override async Task OnInitializedAsync() => await LoadOwners();

    private async Task LoadOwners() => owners = await Api.GetOwnersAsync();

    private async Task RegisterOwner()
    {
        if (string.IsNullOrWhiteSpace(ownerModel.Dni) || !Regex.IsMatch(ownerModel.Dni, @"^\d{8}$"))
        {
            ownerOk = false;
            ownerMsg = "❌ El DNI debe tener exactamente 8 dígitos numéricos";
            return;
        }

        if (!string.IsNullOrWhiteSpace(ownerModel.Phone) && !Regex.IsMatch(ownerModel.Phone, @"^\d{9}$"))
        {
            ownerOk = false;
            ownerMsg = "❌ El teléfono debe tener exactamente 9 dígitos numéricos";
            return;
        }

        var (success, error) = await Api.RegisterOwnerAsync(ownerModel);
        ownerOk = success;
        ownerMsg = success ? "✅ Propietario registrado" : $"❌ {error}";
        if (success)
        {
            ownerModel = new();
            await LoadOwners();
        }
    }

    private async Task RegisterPet()
    {
        if (petModel.OwnerId == 0)
        {
            petOk = false;
            petMsg = "❌ Selecciona un propietario";
            return;
        }

        if (string.IsNullOrWhiteSpace(petModel.Name))
        {
            petOk = false;
            petMsg = "❌ El nombre de la mascota es obligatorio";
            return;
        }

        var (success, error) = await Api.RegisterPetAsync(petModel);
        petOk = success;
        petMsg = success ? "✅ Mascota registrada" : $"❌ {error}";
        if (success)
        {
            petModel = new();
            await LoadOwners();
        }
    }
}