@inject VetClinic.Web.Services.AuthStateService AuthState
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (AuthState.Role is not "Administrador")
        {
            Nav.NavigateTo("/owners");
        }
    }
}

@page "/user-management"
@inject VetClinic.Web.Services.ApiClient Api
@inject IJSRuntime JS
@rendermode InteractiveServer
@using VetClinic.Web.Models

<h3>🛡️ Administración de Usuarios y Roles</h3>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol actual</th>
            <th>Estado</th>
            <th>Cambiar rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in users)
        {
            <tr>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td><span class="badge bg-primary">@u.RoleName</span></td>
                <td>
                    <span class="badge @(u.IsActive == true ? "bg-success" : "bg-secondary")">
                        @(u.IsActive == true ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td class="d-flex gap-2">
                    <select class="form-select form-select-sm" style="width:180px" @bind="selectedRole[u.Id]">
                        <option value="1">Administrador</option>
                        <option value="2">Veterinario</option>
                        <option value="3">Recepcionista</option>
                        <option value="4">Estilista</option>
                    </select>
                    <button class="btn btn-sm btn-primary" @onclick="() => ChangeRole(u.Id)">
                        Guardar
                    </button>
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(u)">
                        🗑️ Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (msg != null) { <div class="alert alert-info mt-2">@msg</div> }

@if (userToDelete != null)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content p-3">
                <h5>⚠️ Confirmar eliminación</h5>
                <p>¿Seguro que deseas eliminar a <strong>@userToDelete.FullName</strong>? Esta acción no se puede deshacer.</p>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> users = new();
    private Dictionary<int, int> selectedRole = new();
    private string? msg;
    private UserDto? userToDelete;

    protected override async Task OnInitializedAsync() => await LoadUsers();

    private async Task LoadUsers()
    {
        users = await Api.GetAllUsersAsync();
        foreach (var u in users)
        {
            selectedRole[u.Id] = u.RoleName switch
            {
                "Administrador" => 1,
                "Veterinario" => 2,
                "Recepcionista" => 3,
                "Estilista" => 4,
                _ => 1
            };
        }
    }

    private async Task ChangeRole(int userId)
    {
        var success = await Api.AssignRoleAsync(new AssignRoleRequest
        {
            UserId = userId,
            RoleId = selectedRole[userId]
        });

        msg = success ? "✅ Rol actualizado" : "❌ Error al actualizar rol";
        if (success) await LoadUsers();
    }

    private void ConfirmDelete(UserDto user) => userToDelete = user;

    private void CancelDelete() => userToDelete = null;

    private async Task DeleteConfirmed()
    {
        if (userToDelete is null) return;

        var (success, error) = await Api.DeleteUserAsync(userToDelete.Id);
        msg = success
            ? $"✅ Usuario '{userToDelete.FullName}' eliminado"
            : $"❌ {error}";

        userToDelete = null;
        if (success) await LoadUsers();
    }
}