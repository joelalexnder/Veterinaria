@inject VetClinic.Web.Services.AuthStateService AuthState
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        if (!AuthState.IsAuthenticated)
            Nav.NavigateTo("/login");
    }
}

@page "/appointments"
@inject VetClinic.Web.Services.ApiClient Api
@inject IJSRuntime JS
@rendermode InteractiveServer
@using VetClinic.Web.Models

<div class="page-header">
    <i class="bi bi-calendar-event"></i>
    <h3>Citas</h3>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card card-accent-primary">
            <div class="section-title"><i class="bi bi-calendar-plus"></i> Agendar Cita</div>
            <EditForm Model="model" OnValidSubmit="Schedule">
                <label class="form-label small">Propietario</label>
                <select class="form-select mb-2" value="@selectedOwnerId" @onchange="OnOwnerChanged">
                    <option value="0">-- Propietario --</option>
                    @foreach (var o in owners)
                    {
                        <option value="@o.Id">@o.FullName</option>
                    }
                </select>

                <label class="form-label small">Mascota</label>
                <select class="form-select mb-2" @bind="model.PetId">
                    <option value="0">-- Mascota --</option>
                    @foreach (var p in pets)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>

                <label class="form-label small">Área de servicio</label>
                <select class="form-select mb-2" value="@model.ServiceAreaId" @onchange="OnServiceAreaChanged">
                    <option value="0">-- Área de servicio --</option>
                    @foreach (var a in areas)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>

                <label class="form-label small">Especialista</label>
                <select class="form-select mb-2" @bind="model.SpecialistId">
                    <option value="0">-- Especialista --</option>
                    @foreach (var s in specialists)
                    {
                        <option value="@s.Id">@s.FullName (@s.SpecialtyName)</option>
                    }
                </select>

                <label class="form-label small">Fecha</label>
                <input type="date" class="form-control mb-2" value="@dateStr" @onchange="@(e => dateStr = e.Value?.ToString() ?? dateStr)" />

                <label class="form-label small">Horario</label>
                <div class="d-flex gap-2 mb-2">
                    <input type="time" class="form-control" value="@startStr" @onchange="@(e => startStr = e.Value?.ToString() ?? startStr)" />
                    <input type="time" class="form-control" value="@endStr" @onchange="@(e => endStr = e.Value?.ToString() ?? endStr)" />
                </div>

                <button class="btn btn-primary w-100"><i class="bi bi-check-circle"></i>Agendar</button>
            </EditForm>

            @if (msg != null) { <div class="alert alert-info mt-3 mb-0">@msg</div> }
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="section-title mb-0"><i class="bi bi-list-check"></i> Citas del día</div>
                <div class="d-flex align-items-center gap-2">
                    <input type="date" class="form-control form-control-sm" style="width:160px" value="@filterDateStr" @onchange="OnFilterDateChanged" />
                    <button class="btn btn-sm btn-outline-success" @onclick="DownloadReport" disabled="@downloading">
                        <i class="bi bi-file-earmark-excel"></i>@(downloading ? "Generando..." : "Reporte")
                    </button>
                </div>
            </div>
            @if (downloadError != null) { <div class="alert alert-danger py-2">@downloadError</div> }
            <table class="table table-sm table-striped align-middle mb-0">
                <thead><tr><th>Mascota</th><th>Especialista</th><th>Área</th><th>Hora</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var a in appointments)
                    {
                        <tr>
                            <td>@a.PetName</td>
                            <td>@a.SpecialistName</td>
                            <td>@a.ServiceAreaName</td>
                            <td>@a.StartTime - @a.EndTime</td>
                            <td><span class="badge bg-warning">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private ScheduleAppointmentRequest model = new();
    private List<OwnerDto> owners = new();
    private List<PetDto> pets = new();
    private List<ServiceAreaDto> areas = new();
    private List<SpecialistDto> specialists = new();
    private List<AppointmentDto> appointments = new();

    private int selectedOwnerId;
    private string dateStr = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    private string startStr = "10:00";
    private string endStr = "10:30";
    private string filterDateStr = DateTime.Today.ToString("yyyy-MM-dd");
    private string? msg;
    private bool downloading;
    private string? downloadError;

    protected override async Task OnInitializedAsync()
    {
        owners = await Api.GetOwnersAsync();
        areas = await Api.GetServiceAreasAsync();
        await LoadAppointments();
    }

    private async Task OnOwnerChanged(ChangeEventArgs e)
    {
        selectedOwnerId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        model.PetId = 0;

        pets = selectedOwnerId > 0
            ? await Api.GetPetsByOwnerAsync(selectedOwnerId)
            : new List<PetDto>();
    }

    private async Task OnServiceAreaChanged(ChangeEventArgs e)
    {
        model.ServiceAreaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        model.SpecialistId = 0;

        specialists = model.ServiceAreaId > 0
            ? await Api.GetSpecialistsAsync(model.ServiceAreaId)
            : new List<SpecialistDto>();
    }

    private async Task OnFilterDateChanged(ChangeEventArgs e)
    {
        filterDateStr = e.Value?.ToString() ?? filterDateStr;
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        var date = DateOnly.Parse(filterDateStr);
        appointments = await Api.GetAppointmentsByDateAsync(date);
    }

    private async Task Schedule()
    {
        if (model.PetId == 0 || model.SpecialistId == 0 || model.ServiceAreaId == 0)
        {
            msg = "❌ Completa todos los campos";
            return;
        }

        model.AppointmentDate = DateOnly.Parse(dateStr);
        model.StartTime = TimeOnly.Parse(startStr);
        model.EndTime = TimeOnly.Parse(endStr);

        var (success, error) = await Api.ScheduleAppointmentAsync(model);
        msg = success ? "✅ Cita agendada" : $"❌ {error}";

        if (success)
        {
            model = new();
            selectedOwnerId = 0;
            pets = new();
            specialists = new();
            await LoadAppointments();
        }
    }

    private async Task DownloadReport()
    {
        downloading = true;
        downloadError = null;

        var date = DateOnly.Parse(filterDateStr);
        var bytes = await Api.GetAppointmentsReportAsync(date);

        if (bytes is null)
        {
            downloadError = "❌ No se pudo generar el reporte";
        }
        else
        {
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Citas_{filterDateStr}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, base64);
        }

        downloading = false;
    }
}